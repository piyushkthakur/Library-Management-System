# Library Management System — environment configuration template
# Copy to .env and fill in real values. Never commit .env (Volume 1, Chapter 28).

# MySQL (via XAMPP) — Volume 3, Chapter 20.1
DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_db
DB_USER=root
DB_PASSWORD=

# Gmail SMTP for OTP delivery — Volume 3, Chapter 20.1
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Runtime environment: development / production
APP_ENV=development
